<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- CDM picker is a system feature; not required so the app still installs on
       devices that lack it (we gate at runtime via isSupported()). -->
  <uses-feature
    android:name="android.software.companion_device_setup"
    android:required="false" />

  <!-- Needed to receive ACL connect/disconnect broadcasts and to read a device
       name (API 31+). The picker itself needs no location permission. -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Companion-association exemptions: let the app run / start from background
       when its associated device is around. -->
  <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
  <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />

  <!-- Posting the connect/disconnect notification when the app is dead (API 33+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Wakes the app on car Bluetooth connect/disconnect. exported=true is
         required to receive these system broadcasts via a manifest receiver. -->
    <receiver
      android:name="expo.modules.carbluetooth.CarAclReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
        <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
